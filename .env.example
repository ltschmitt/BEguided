# Copy to `.env` and edit for your host.
# `.env` is gitignored.

# Host directory with the reference FASTA + GTF, mounted read-only into the
# container at /app/genome. Must contain files named:
#   Homo_sapiens.GRCh38.dna.primary_assembly.fa
#   Homo_sapiens.GRCh38.dna.primary_assembly.fa.fai
#   Homo_sapiens.GRCh38.112.gtf
# (or update the BEGUIDED_GENOME_FASTA / BEGUIDED_GTF_PATH paths in
# docker-compose.yml to match your filenames).
#
# Note: bind mounts do not follow symlinks to paths outside the mount source.
# If your reference files live behind symlinks, point GENOME_HOST_DIR at the
# real directory, not at a symlink farm.
GENOME_HOST_DIR=./genome

# Host port to publish (container port is always 8000).
PORT=8000

# Display label shown in the UI.
BEGUIDED_GENOME_LABEL=GRCh38.112
